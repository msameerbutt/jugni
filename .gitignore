# --- Security boundary (spec §4): real PII must never reach the public repo ---
# A trip owns its raw/, intake/ and input/, so ignoring trips/ covers all three:
# booking PDFs, extracted text, names, GPS coordinates, confirmation numbers.
trips/*
!trips/.gitkeep
input.json
output-*.json
output.json

# --- Build output ---
dist/
*.pyc
__pycache__/
.pytest_cache/

# --- Editors / OS ---
.DS_Store
.idea/
.vscode/
*.swp
.make/
